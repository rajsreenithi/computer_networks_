#include "network_db.h"

void binaryToText() {
    int len = strlen(recoveredBinary);
    int charCount = 0;
    int i, j;
    for(i = 0; i < len; i += 8) {
        int decimalValue = 0;
        for(j = 0; j < 8; j++) {
            decimalValue = (decimalValue << 1) + (recoveredBinary[i + j] - '0');
        }
        recoveredMessage[charCount++] = (char)decimalValue;
    }
    recoveredMessage[charCount] = '\0';
}

void receiver() {
    char temp[MAXBIN];
    int errorDetected = 0;
    int i, j, dataLength, generatorLength;
    int injectError = 0;

    printf("\n=================== RECEIVER DECODING LAYER ===================\n");
    strcpy(receivedCodeword, frame.codeword);
    printf("Do you want to inject an error for testing? (1 for Yes, 0 for No): ");
    scanf("%d", &injectError);

    if(injectError == 1) {
        receivedCodeword[0] = (receivedCodeword[0] == '0') ? '1' : '0';
        printf("Received BitStream Codeword (CORRUPTED): %s\n", receivedCodeword);
    } else {
        printf("Received BitStream Codeword : %s\n", receivedCodeword);
    }

    strcpy(temp, receivedCodeword);
    dataLength = strlen(temp);
    generatorLength = strlen(frame.generator);

    for(i = 0; i <= dataLength - generatorLength; i++) {
        if(temp[i] == '1') {
            for(j = 0; j < generatorLength; j++) {
                temp[i + j] = (temp[i + j] == frame.generator[j]) ? '0' : '1';
            }
        }
    }

    for(i = dataLength - (generatorLength - 1); i < dataLength; i++) {
        if(temp[i] != '0') {
            errorDetected = 1;
            break;
        }
    }

    printf("\n---------------------------------------------------\n");
    printf("                   FINAL DETECT STATUS             \n");
    printf("---------------------------------------------------\n");

    if(errorDetected) {
        printf(">>> ERROR STATUS   : YES (Error is Present in Data!)\n");
        printf(">>> ACTIONS TAKEN  : Frame Discarded.\n");
    } else {
        printf(">>> ERROR STATUS   : NO (No Error Found)\n");
        printf(">>> ACTIONS TAKEN  : Frame Accepted & Processing .\n");

        int messageLength = strlen(receivedCodeword) - (generatorLength - 1);
        strncpy(recoveredBinary, receivedCodeword, messageLength);
        recoveredBinary[messageLength] = '\0';

        binaryToText();

        printf("\nSource MAC                   : %s", frame.sourceMAC);
        printf("\nDestination MAC              : %s", frame.destinationMAC);
        printf("\nSource IP                    : %s", frame.sourceIP);
        printf("\nDestination IP               : %s", frame.destinationIP);
        printf("\n\nRecovered Binary Message     : %s", recoveredBinary);
        printf("\nRecovered Message            : %s\n", recoveredMessage);
    }
}

int main() {
    char srcURL[30], destURL[30], polyExpr[100];
    int srcIndex, destIndex;

    showHosts();

    printf("\nEnter Source Host URL: ");
    scanf("%29s", srcURL);
    srcIndex = findHost(srcURL);
    while (srcIndex == -1) {
        printf("Invalid URL! Enter Source Host URL again: ");
        scanf("%29s", srcURL);
        srcIndex = findHost(srcURL);
    }

    printf("Enter Destination Host URL: ");
    scanf("%29s", destURL);
    destIndex = findHost(destURL);
    while (destIndex == -1) {
        printf("Invalid URL! Enter Destination Host URL again: ");
        scanf("%29s", destURL);
        destIndex = findHost(destURL);
    }

    strcpy(frame.sourceURL, hostTable[srcIndex].url);
    strcpy(frame.sourceIP, hostTable[srcIndex].ip);
    strcpy(frame.sourceMAC, hostTable[srcIndex].mac);

    strcpy(frame.destinationURL, hostTable[destIndex].url);
    strcpy(frame.destinationIP, hostTable[destIndex].ip);
    strcpy(frame.destinationMAC, hostTable[destIndex].mac);

    printf("\nEnter Message to send: ");
    getchar(); // Clear newline
    fgets(frame.message, MAXMSG, stdin);
    frame.message[strcspn(frame.message, "\r\n")] = '\0'; // Remove trailing newline

    printf("Enter Generator Polynomial (e.g. xpow3+x+1): ");
    scanf("%99s", polyExpr);

    parsePolynomial(polyExpr, frame.generator);
    printf("Generator Binary Representation: %s\n", frame.generator);

    sender();
    appendZero();
    crc();
    receiver();

    return 0;
}
