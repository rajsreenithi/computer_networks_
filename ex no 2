#define TOTALHOSTS 4
#define MAXMSG 200
#define MAXBIN 5000

struct Host {
    char url[30];
    char ip[20];
    char mac[25];
};

struct Frame {
    char sourceURL[30];
    char destinationURL[30];
    char sourceIP[20];
    char destinationIP[20];
    char sourceMAC[25];
    char destinationMAC[25];
    char message[MAXMSG];
    char binaryMessage[MAXBIN];
    char generator[20];
    char dividend[MAXBIN];
    char remainder[20];
    char codeword[MAXBIN];
};

extern struct Host hostTable[TOTALHOSTS];
extern struct Frame frame;
extern char receivedCodeword[MAXBIN];
extern char recoveredBinary[MAXBIN];
extern char recoveredMessage[MAXMSG];

#endif


