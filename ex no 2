#include "network_db.h"

struct Host hostTable[TOTALHOSTS] = {
    {"amazon.com", "192.168.10.2", "10:20:30:40:50:60"},
    {"facebook.com", "192.168.10.3", "11:22:33:44:55:66"},
    {"youtube.com", "192.168.10.4", "AA:11:BB:22:CC:33"},
    {"github.com", "192.168.10.5", "12:34:56:78:9A:BC"}
};

struct Frame frame;
char receivedCodeword[MAXBIN];
char recoveredBinary[MAXBIN];
char recoveredMessage[MAXMSG];

void showHosts() {
    int i;
    printf("\nAvailable Host Details\n---------------------------------------------\n");
    printf("%-5s %-20s %-18s %-22s\n", "No", "URL", "IP Address", "MAC Address");
    printf("-------------------------------------------------------------\n");
    for(i = 0; i < TOTALHOSTS; i++) {
        printf("%-5d %-20s %-18s %-22s\n", i + 1, hostTable[i].url, hostTable[i].ip, hostTable[i].mac);
    }
}

int findHost(char url[]) {
    int i;
    for(i = 0; i < TOTALHOSTS; i++) {
        if(strcmp(hostTable[i].url, url) == 0) return i;
    }
    return -1;
}

void parsePolynomial(char expr[], char binaryGen[]) {
    char upperExpr[100];
    int presentExponents[50] = {0};
    int maxDegree = 0;
    int i = 0, j = 0;
    char *token;

    for (i = 0; expr[i] != '\0'; i++) {
        if (expr[i] != ' ' && expr[i] != '\r' && expr[i] != '\n') {
            upperExpr[j++] = toupper((unsigned char)expr[i]);
        }
    }
    upperExpr[j] = '\0';

    token = strtok(upperExpr, "+");
    while (token != NULL) {
        int currentDegree = -1;
        if (strstr(token, "XPOW") != NULL) {
            currentDegree = atoi(token + 4);
        } else if (strcmp(token, "X") == 0) {
            currentDegree = 1;
        } else if (strcmp(token, "1") == 0) {
            currentDegree = 0;
        }

        if (currentDegree >= 0 && currentDegree < 50) {
            presentExponents[currentDegree] = 1;
            if (currentDegree > maxDegree) maxDegree = currentDegree;
        }
        token = strtok(NULL, "+");
    }

    j = 0;
    for (i = maxDegree; i >= 0; i--) {
        binaryGen[j++] = (presentExponents[i] == 1) ? '1' : '0';
    }
    binaryGen[j] = '\0';
}

void decimalToBinary(int num, char binary[]) {
    int i;
    for(i = 7; i >= 0; i--) {
        binary[i] = (num % 2) + '0';
        num /= 2;
    }
    binary[8] = '\0';
}

void convertIP(char ip[]) {
    char temp[30], binary[9], *token;
    strcpy(temp, ip);
    token = strtok(temp, ".");
    while(token != NULL) {
        decimalToBinary(atoi(token), binary);
        printf("%s ", binary);
        token = strtok(NULL, ".");
    }
    printf("\n");
}

void convertMAC(char mac[]) {
    char temp[30], binary[9], *token;
    strcpy(temp, mac);
    token = strtok(temp, ":");
    while(token != NULL) {
        decimalToBinary((int)strtol(token, NULL, 16), binary);
        printf("%s ", binary);
        token = strtok(NULL, ":");
    }
    printf("\n");
}

void convertMessage(char message[]) {
    char binary[9];
    int i;
    frame.binaryMessage[0] = '\0';
    for(i = 0; message[i] != '\0'; i++) {
        decimalToBinary((unsigned char)message[i], binary);
        strcat(frame.binaryMessage, binary);
    }
}

void sender() {
    printf("\n=================== SENDER LAYER ===================\n");
    printf("Original Message               : %s\n", frame.message);
    printf("\nSOURCE IP IN BINARY           : ");
    convertIP(frame.sourceIP);
    printf("DESTINATION IP IN BINARY      : ");
    convertIP(frame.destinationIP);
    printf("SOURCE MAC IN BINARY          : ");
    convertMAC(frame.sourceMAC);
    printf("DESTINATION MAC IN BINARY     : ");
    convertMAC(frame.destinationMAC);
    convertMessage(frame.message);
    printf("MESSAGE IN BINARY             : %s\n", frame.binaryMessage);
}

void appendZero() {
    int i;
    int k = strlen(frame.generator) - 1;
    strcpy(frame.dividend, frame.binaryMessage);
    for(i = 0; i < k; i++) strcat(frame.dividend, "0");
}

void crc() {
    char temp[MAXBIN];
    int i, j, dataLength, generatorLength;
    strcpy(temp, frame.dividend);
    dataLength = strlen(temp);
    generatorLength = strlen(frame.generator);

    for(i = 0; i <= dataLength - generatorLength; i++) {
        if(temp[i] == '1') {
            for(j = 0; j < generatorLength; j++) {
                temp[i + j] = (temp[i + j] == frame.generator[j]) ? '0' : '1';
            }
        }
    }

    strncpy(frame.remainder, &temp[dataLength - (generatorLength - 1)], generatorLength - 1);
    frame.remainder[generatorLength - 1] = '\0';
    strcpy(frame.codeword, frame.binaryMessage);
    strcat(frame.codeword, frame.remainder);
}


