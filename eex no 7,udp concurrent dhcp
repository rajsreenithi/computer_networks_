#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 1024

int socketfd;
struct sockaddr_in serverAddr;
socklen_t addrLen;
char buffer[BUFFER_SIZE];
char clientName[100];
int subnetChoice;

void createSocket() {
    socketfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (socketfd < 0) {
        perror("socket creation failed");
        exit(1);
    }
}

void setServerAddress(char *ip, int port) {
    memset(&serverAddr, 0, sizeof(serverAddr));
    serverAddr.sin_family = AF_INET;
    serverAddr.sin_port = htons(port);

    if (inet_pton(AF_INET, ip, &serverAddr.sin_addr) <= 0) {
        printf("invalid server IP\n");
        close(socketfd);
        exit(1);
    }

    addrLen = sizeof(serverAddr);
    printf("server address configured successfully \n");
}

void getClientDetails() {
    printf("\n enter client name : ");
    scanf("%s", clientName);
}

void sendDHCPDiscover() {
    strcpy(buffer, "DHCPDISCOVER");
    printf("\n sending DHCP Discover to server \n");
    sendto(socketfd, buffer, strlen(buffer) + 1, 0, (struct sockaddr *)&serverAddr, addrLen);
}

void receiveDHCPOffer() {
    memset(buffer, 0, BUFFER_SIZE);
    recvfrom(socketfd, buffer, BUFFER_SIZE, 0, (struct sockaddr *)&serverAddr, &addrLen);
    printf("received DHCP Offer : %s\n", buffer);
}

void getSubnetChoice() {
    printf("enter subnet choice : ");
    scanf("%d", &subnetChoice);
}

void sendDHCPRequest() {
    sprintf(buffer, "DHCPREQUEST %d", subnetChoice);
    printf("sending DHCP Request for subnet %d\n", subnetChoice);
    sendto(socketfd, buffer, strlen(buffer) + 1, 0, (struct sockaddr *)&serverAddr, addrLen);
}

void receiveDHCPACK() {
    memset(buffer, 0, BUFFER_SIZE);
    recvfrom(socketfd, buffer, BUFFER_SIZE, 0, (struct sockaddr *)&serverAddr, &addrLen);
    printf("\n--- DHCP ACK Response ---\n%s\n", buffer);
}

int main() {
    createSocket();
    setServerAddress("127.0.0.1", PORT);
    getClientDetails();

    sendDHCPDiscover();
    receiveDHCPOffer();

    getSubnetChoice();
    sendDHCPRequest();
    receiveDHCPACK();

    close(socketfd);
    return 0;
}
