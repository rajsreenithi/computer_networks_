#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/types.h>

#define SERVER_PORT 8080
#define BUFFER_SIZE 1024

int sockfd;

void createSocket() {
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sockfd < 0) {
        perror("socket");
        exit(EXIT_FAILURE);
    }
}

void initializeServer(struct sockaddr_in *server_addr) {
    memset(server_addr, 0, sizeof(*server_addr));
    server_addr->sin_family = AF_INET;
    server_addr->sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr->sin_port = htons(SERVER_PORT);

    if (bind(sockfd, (struct sockaddr *)server_addr, sizeof(*server_addr)) < 0) {
        perror("bind");
        exit(EXIT_FAILURE);
    }
    printf("Server started at port %d\n", SERVER_PORT);
}

void chat() {
    char buffer[BUFFER_SIZE];
    struct sockaddr_in client_addr;
    socklen_t len;
    int n;

    while (1) {
        len = sizeof(client_addr);
        n = recvfrom(sockfd, buffer, BUFFER_SIZE - 1, 0, (struct sockaddr *)&client_addr, &len);
        if (n < 0) {
            perror("recvfrom");
            continue;
        }
        buffer[n] = '\0';

        if (fork() == 0) {
            printf("received from client : %s\n", buffer);
            printf("enter message : ");
            fgets(buffer, BUFFER_SIZE, stdin);
            buffer[strcspn(buffer, "\n")] = '\0';
            sendto(sockfd, buffer, strlen(buffer), 0, (struct sockaddr *)&client_addr, len);
            printf("message sent to client\n");
            close(sockfd);
            exit(0);
        }
    }
}

void closeConnection() {
    close(sockfd);
}

int main() {
    struct sockaddr_in server_addr;

    createSocket();
    initializeServer(&server_addr);
    chat();
    closeConnection();

    return 0;
}
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SERVER_IP "127.0.0.1"
#define SERVER_PORT 8080
#define BUFFER_SIZE 1024

int socket_fd;
struct sockaddr_in server_address;

int createSocket() {
    socket_fd = socket(AF_INET, SOCK_DGRAM, 0);
    if (socket_fd < 0) {
        perror("socket");
        exit(EXIT_FAILURE);
    }
    return 0;
}

void initializeServer() {
    memset(&server_address, 0, sizeof(server_address));
    server_address.sin_family = AF_INET;
    server_address.sin_port = htons(SERVER_PORT);

    if (inet_pton(AF_INET, SERVER_IP, &server_address.sin_addr) <= 0) {
        printf("invalid server address\n");
        exit(1);
    }
}

void chat() {
    char buffer[BUFFER_SIZE];
    int n;

    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        printf("enter message : ");
        fgets(buffer, BUFFER_SIZE, stdin);
        buffer[strcspn(buffer, "\n")] = '\0';

        sendto(socket_fd, buffer, strlen(buffer), 0, (struct sockaddr *)&server_address, sizeof(server_address));

        n = recvfrom(socket_fd, buffer, BUFFER_SIZE - 1, 0, NULL, NULL);
        if (n < 0) {
            printf("Receive failed\n");
            break;
        }

        buffer[n] = '\0';
        printf("server : %s\n", buffer);

        if (strcmp(buffer, "exit") == 0) {
            break;
        }
    }
}

void closeConnection() {
    close(socket_fd);
}

int main() {
    if (createSocket() < 0) {
        return 1;
    }
    initializeServer();
    chat();
    closeConnection();

    return 0;
}
