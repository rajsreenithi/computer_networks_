#include <stdlib.h>
int* maxSlidingWindow(int* nums, int numsSize, int k, int* returnSize) {
    if (numsSize == 0 || k == 0) {
        *returnSize = 0;
        return NULL;
    }

    
    int resCapacity = numsSize - k + 1;
    int* result = (int*)malloc(resCapacity * sizeof(int));
    *returnSize = 0;

   
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0; // Front of the queue
    int tail = 0; // Back of the queue

    for (int i = 0; i < numsSize; i++) {
       
        if (head < tail && deque[head] < i - k + 1) {
            head++;
        }

       
        while (head < tail && nums[deque[tail - 1]] <= nums[i]) {
            tail--;
        }

        deque[tail++] = i;

        
        if (i >= k - 1) {
            result[(*returnSize)++] = nums[deque[head]];
        }
    }

   
    free(deque);
    
    return result;
}
