#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define SERVER_PORT 8003

char work[1200];
int s;
int len;
struct sockaddr_in servAddr;
struct sockaddr_in clntAddr;
socklen_t clntAddrLen;
char buffer[1200];

unsigned short verifyChecksum(const char* binaryStr) {
    unsigned int sum = 0;
    int len = strlen(binaryStr);
    int i, j;

    for (i = 0; i < len; i += 16) {
        unsigned short word = 0;
        for (j = 0; j < 16; j++) {
            word <<= 1;
            if (i + j < len && binaryStr[i + j] == '1') {
                word |= 1;
            }
        }
        sum += word;
        while (sum >> 16) {
            sum = (sum & 0xFFFF) + (sum >> 16);
        }
    }
    return (unsigned short)(~sum);
}

int main(void) {
    unsigned short resultSum;

    memset(&servAddr, 0, sizeof(servAddr));
    servAddr.sin_family = AF_INET;
    servAddr.sin_port = htons(SERVER_PORT);
    servAddr.sin_addr.s_addr = htonl(INADDR_ANY);

    s = socket(PF_INET, SOCK_DGRAM, 0);
    if (s < 0) {
        perror("Error: socket failed!");
        exit(1);
    }

    if (bind(s, (struct sockaddr*)&servAddr, sizeof(servAddr)) < 0) {
        perror("Error: bind failed!");
        exit(1);
    }

    printf("Checksum server started on port %d...\n", SERVER_PORT);
    clntAddrLen = sizeof(clntAddr);

    len = recvfrom(s, buffer, sizeof(buffer) - 1, 0, (struct sockaddr*)&clntAddr, &clntAddrLen);
    if (len < 0) {
        perror("Error: recvfrom failed!");
        exit(1);
    }

    buffer[len] = '\0';
    strcpy(work, buffer);

    printf("Received Codeword : %s\n", work);
    resultSum = verifyChecksum(work);

    if (resultSum == 0) {
        strcpy(buffer, "No error detected - packet accepted");
        printf("Result: Valid packet.\n");
    } else {
        strcpy(buffer, "Error detected - packet discarded");
        printf("Result: Corrupted packet detected.\n");
    }

    sendto(s, buffer, strlen(buffer), 0, (struct sockaddr*)&clntAddr, clntAddrLen);
    close(s);
    return 0;
