/* ========================================================================== */
/*                              RECEIVER PROGRAM                              */
/* ========================================================================== */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define SIZE 256
#define LOSSPROB 25

int sfd;
struct sockaddr_in saddr, caddr;
socklen_t clen;
char buf[SIZE];
int expected;

int simloss() {
    return (rand() % 100) < LOSSPROB;
}

unsigned char calcchk(char *d, int l) {
    unsigned int sum = 0;
    int i;
    for (i = 0; i < l; i++) {
        sum = sum + (unsigned char)d[i];
    }
    return (unsigned char)(sum % 0xFF);
}

void tobin(unsigned char val, char *out) {
    int i;
    for (i = 7; i >= 0; i--) {
        out[7 - i] = ((val >> i) & 1) ? '1' : '0';
    }
    out[8] = '\0';
}

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    srand(time(NULL));

    printf("=== Stop-and-Wait ARQ Receiver ===\n\n");

    sfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sfd < 0) {
        perror("socket");
        return 1;
    }

    memset(&saddr, 0, sizeof(saddr));
    saddr.sin_family = AF_INET;
    saddr.sin_port = htons(atoi(argv[1]));
    saddr.sin_addr.s_addr = INADDR_ANY;

    if (bind(sfd, (struct sockaddr *)&saddr, sizeof(saddr)) < 0) {
        perror("bind");
        close(sfd);
        return 1;
    }

    printf("Waiting for sender on port %s...\n", argv[1]);

    expected = 0;
    int connected = 0;

    while (1) {
        clen = sizeof(caddr);
        int n = recvfrom(sfd, buf, SIZE - 1, 0, (struct sockaddr *)&caddr, &clen);
        if (n < 0) {
            perror("recvfrom");
            continue;
        }
        buf[n] = '\0';

        if (!connected) {
            printf("Sender connected.\n\n");
            connected = 1;
        }

        if (strcmp(buf, "END") == 0) {
            printf("\n=== All packets received successfully ===\n");
            break;
        }

        int seq;
        unsigned int rchk;
        char data[SIZE];
        sscanf(buf, "%d;%u;%[^\n]", &seq, &rchk, data);

        unsigned char calc = calcchk(data, strlen(data));
        char rbin[9];
        tobin((unsigned char)rchk, rbin);

        printf("\nFrame %d received [\"%s\"], checksum %s\n", seq, rbin, rbin);

        if (calc != (unsigned char)rchk) {
            printf("Checksum verified: ERROR DETECTED, no ACK sent\n");
            continue;
        }

        printf("Checksum verified: OK\n");

        if (seq == expected) {
            int ackval = 1 - seq;
            expected = 1 - expected;
            printf("Sending ACK %d\n", ackval);

            if (simloss()) {
                printf("ACK %d lost in transit\n", ackval);
            } else {
                char ack[10];
                sprintf(ack, "%d", ackval);
                sendto(sfd, ack, strlen(ack), 0, (struct sockaddr *)&caddr, clen);
            }
        } else {
            printf("Duplicate Frame %d, discarding\n", seq);
            int ackval = 1 - seq;
            printf("Resending ACK %d\n", ackval);
            char ack[10];
            sprintf(ack, "%d", ackval);
            sendto(sfd, ack, strlen(ack), 0, (struct sockaddr *)&caddr, clen);
        }
    }

    close(sfd);
    return 0;
}


/* ========================================================================== */
/*                               SENDER PROGRAM                               */
/* ========================================================================== */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define SIZE 256
#define LOSSPROB 25

struct pkt {
    char data[SIZE];
    struct pkt *next;
};

struct pkt *head = NULL, *tail = NULL;
struct pkt *arr[100];
int cnt, seq;
int sfd;
struct sockaddr_in raddr;
socklen_t len;
char buf[SIZE];
int cpkt, cbit;
int isentonce[100];

void addpkt(char *d) {
    struct pkt *n = (struct pkt *)malloc(sizeof(struct pkt));
    strcpy(n->data, d);
    n->next = NULL;
    if (head == NULL) {
        head = n;
        tail = n;
    } else {
        tail->next = n;
        tail = n;
    }
}

unsigned char calcchk_s(char *d, int l) {
    unsigned int sum = 0;
    int i;
    for (i = 0; i < l; i++) {
        sum = sum + (unsigned char)d[i];
    }
    return (unsigned char)(sum % 0xFF);
}

void flipbit(char *d, int bit) {
    int byteidx = bit / 8;
    int bitidx = bit % 8;
    d[byteidx] ^= (1 << (7 - bitidx));
}

int simloss_s() {
    return (rand() % 100) < LOSSPROB;
}

int main(int argc, char *argv[]) {
    if (argc != 3) {
        printf("Usage: %s <receiver_ip> <port>\n", argv[0]);
        return 1;
    }

    srand(time(NULL));

    printf("=== Stop-and-Wait ARQ with Checksum ===\n\n");
    printf("Enter number of packets: ");
    scanf("%d", &cnt);
    getchar();

    int i;
    for (i = 0; i < cnt; i++) {
        char temp[SIZE];
        printf("Enter data for packet %d: ", i + 1);
        fgets(temp, SIZE, stdin);
        temp[strcspn(temp, "\n")] = '\0';
        addpkt(temp);
    }

    struct pkt *cur = head;
    for (i = 0; i < cnt; i++) {
        arr[i] = cur;
        cur = cur->next;
    }

    cpkt = -1;
    char ans[10];
    printf("\nDo you want to introduce an error in any packet (y/n): ");
    scanf("%s", ans);
    if (ans[0] == 'y' || ans[0] == 'Y') {
        printf("Enter packet number to corrupt (1-%d): ", cnt);
        scanf("%d", &cpkt);
        int dlen = strlen(arr[cpkt - 1]->data);
        printf("Enter bit position to flip (0-%d): ", dlen * 8 - 1);
        scanf("%d", &cbit);
        cpkt = cpkt - 1;
        printf("Bit %d of Packet %d flipped for transmission.\n", cbit, cpkt + 1);
    }

    sfd = socket(AF_INET, SOCK_DGRAM, 0);
    if (sfd < 0) {
        perror("socket");
        return 1;
    }

    memset(&raddr, 0, sizeof(raddr));
    raddr.sin_family = AF_INET;
    raddr.sin_port = htons(atoi(argv[2]));
    inet_pton(AF_INET, argv[1], &raddr.sin_addr);
    len = sizeof(raddr);

    struct timeval tv;
    tv.tv_sec = 2;
    tv.tv_usec = 0;
    setsockopt(sfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));

    printf("\nConnecting to receiver...\n");
    printf("Starting Stop-and-Wait transmission...\n");

    seq = 0;
    for (i = 0; i < cnt; i++) {
        printf("\n--- Sending Packet %d ---\n", i + 1);

        int dlen = strlen(arr[i]->data);
        unsigned char chk = calcchk_s(arr[i]->data, dlen);

        int acked = 0;
        int firsttry = 1;

        while (!acked) {
            char senddata[SIZE];
            strcpy(senddata, arr[i]->data);

            if (i == cpkt && !isentonce[i]) {
                flipbit(senddata, cbit);
                printf("Sending Frame %d [\"%s\"] (bit %d flipped)\n", seq, arr[i]->data, cbit);
            } else if (firsttry) {
                printf("Sending Frame %d [\"%s\"]\n", seq, arr[i]->data);
            } else {
                printf("Sending Frame %d (resent) [\"%s\"]\n", seq, arr[i]->data);
            }

            if (firsttry) {
                isentonce[i] = 1;
            }

            char frame[SIZE + 20];
            sprintf(frame, "%d;%u;%s", seq, chk, senddata);

            int lost = 0;
            if (simloss_s()) {
                printf("Frame lost in transit!\n");
                lost = 1;
            } else {
                sendto(sfd, frame, strlen(frame), 0, (struct sockaddr *)&raddr, len);
            }

            int n = recvfrom(sfd, buf, SIZE - 1, 0, NULL, NULL);
            if (n < 0) {
                printf("Timeout! No ACK received. Resending frame %d...\n", seq);
                firsttry = 0;
                continue;
            }

            buf[n] = '\0';
            int ackseq = atoi(buf);
            int expected_ack = 1 - seq;

            if (ackseq == expected_ack) {
                printf("ACK %d received\n", ackseq);
                printf("Packet %d delivered successfully.\n", i + 1);
                acked = 1;
                seq = 1 - seq;
            } else {
                printf("Old ACK %d received, ignoring\n", ackseq);
            }
        }
    }

    sendto(sfd, "END", 3, 0, (struct sockaddr *)&raddr, len);
    printf("\n=== All %d packets transmitted successfully ===\n", cnt);

    close(sfd);
    return 0;
}
