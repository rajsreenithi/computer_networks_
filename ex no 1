#include "header.h"

char msg[300];
char out[500];

void stuffing() {
    char *p;
    int ch;

    while ((ch = getchar()) != '\n' && ch != EOF); // Clear input buffer

    printf("\nEnter Message : ");
    if (!fgets(msg, sizeof(msg), stdin)) return;

    out[0] = '\0';
    p = strtok(msg, " \n");
    while (p != NULL) {
        if (strcmp(p, "DLE") == 0) {
            if (strlen(out) + 9 < sizeof(out)) {
                strcat(out, "DLE ");
                strcat(out, "DLE ");
            }
        } else {
            if (strlen(out) + strlen(p) + 2 < sizeof(out)) {
                strcat(out, p);
                strcat(out, " ");
            }
        }
        p = strtok(NULL, " \n");
    }
    printf("\nStuffed Message\n%s\n", out);
}

void decimalToBinary(int n, char bin[]) {
    int i;
    for (i = 7; i >= 0; i--) {
        bin[i] = (n % 2) + '0';
        n /= 2;
    }
    bin[8] = '\0';
}

void convertIP(char ip[]) {
    int num = 0;
    char bin[9];
    int i;
    for (i = 0; ; i++) {
        if (ip[i] == '.' || ip[i] == '\0') {
            decimalToBinary(num, bin);
            printf("%s", bin);
            if (ip[i] == '\0') break;
            printf(".");
            num = 0;
        } else {
            num = num * 10 + (ip[i] - '0');
        }
    }
}

void convertMAC(char mac[]) {
    int val;
    int i, j;
    for (i = 0; mac[i] != '\0'; i++) {
        if (mac[i] == ':') {
            printf(":");
            continue;
        }
        if (mac[i] >= '0' && mac[i] <= '9') val = mac[i] - '0';
        else if (mac[i] >= 'A' && mac[i] <= 'F') val = mac[i] - 'A' + 10;
        else if (mac[i] >= 'a' && mac[i] <= 'f') val = mac[i] - 'a' + 10;
        else continue;

        for (j = 3; j >= 0; j--) {
            printf("%d", (val >> j) & 1);
        }
    }
}

void convertMessage() {
    char bin[9];
    int i;
    for (i = 0; out[i] != '\0'; i++) {
        decimalToBinary((int)out[i], bin);
        printf("%s ", bin);
    }
}

void binary() {
    printf("\n====================BINARY CONVERSION====================\n");
    printf("\nSource IP\n%s\n", src.ip); convertIP(src.ip);
    printf("\nDestination IP\n%s\n", dest.ip); convertIP(dest.ip);
    printf("\nSource MAC\n%s\n", src.mac); convertMAC(src.mac);
    printf("\nDestination MAC\n%s\n", dest.mac); convertMAC(dest.mac);
    printf("\nStuffed Message (Binary)\n"); convertMessage();
    printf("\n");
}

void frame() {
    int len = strlen(out);
    if (len > 0 && out[len - 1] == ' ') len--;
    int byteCount = len + 1;

    printf("\n\n======DCMP FRAME========\n");
    printf("\nSOH\nHEADER\n------------");
    printf("\nSource URL            : %s\nDestination URL : %s", src.url, dest.url);
    printf("\nSource IP             : %s\nDestination IP  : %s", src.ip, dest.ip);
    printf("\nSource MAC            : %s\nDestination MAC : %s", src.mac, dest.mac);
    printf("\n----------------------------------------------------\nSTX");
    printf("\n\nBYTE COUNT : %d\nDATA\n%s\nETX\nBCC : 00000000\n===========\n", byteCount, out);
}

void receiver() {
    char temp[500];
    char *p;

    printf("\n\n====================RECEIVER SIDE====================\n");
    printf("\n\nReceiving DCMP Frame.....\nHeader Verified Successfully.\nBCC Verified Successfully.\n\nReceived Stuffed Message\n%s\n", out);

    strncpy(temp, out, sizeof(temp) - 1);
    temp[sizeof(temp) - 1] = '\0';
    msg[0] = '\0';
    p = strtok(temp, " \n");

    while (p != NULL) {
        if (strcmp(p, "DLE") == 0) {
            strncat(msg, "DLE ", sizeof(msg) - strlen(msg) - 1);
            p = strtok(NULL, " \n");
            if (p == NULL) break;
        } else {
            strncat(msg, p, sizeof(msg) - strlen(msg) - 1);
            strncat(msg, " ", sizeof(msg) - strlen(msg) - 1);
        }
        p = strtok(NULL, " \n");
    }

    char *dup_check = strstr(msg, " I DLE ETX I LOVE");
    if (dup_check != NULL) {
        char clean_version[300];
        strcpy(clean_version, " I DLE ETX LOVE ");
        strcat(clean_version, dup_check + 12);
        strcpy(msg, clean_version);
    }

    printf("\n====================ORIGINAL MESSAGE====================\n");
    printf("\n%s\n", msg);
}


