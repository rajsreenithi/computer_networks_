    {"chatgpt.com", "192.168.1.5", "AA:BB:CC:DD:EE:04"}
};

struct Host src, dest;

void display() {
    printf("\nADDRESS TABLE\n\n");
    printf("%-18s %-18s %-20s\n", "URL", "IP ADDRESS", "MAC ADDRESS");
    printf("-------------------------------------------------------------\n");
    for (int i = 0; i < SIZE; i++) {
        printf("%-18s %-18s %-20s\n", host[i].url, host[i].ip, host[i].mac);
    }
    printf("\n");
}

void search() {
    char s[30], d[30];
    int f1, f2;

    do {
        f1 = 0;
        printf("\nEnter Source URL : ");
        if (scanf("%29s", s) != 1) continue;

        for (int i = 0; i < SIZE; i++) {
            if (strcmp(s, host[i].url) == 0) {
                src = host[i];
                f1 = 1;
                break;
            }
        }
        if (f1 == 0) {
            printf("\nSource URL Not Found! Please Enter a Valid Source URL.\n");
        }
    } while (f1 == 0);

    do {
        f2 = 0;
        printf("\nEnter Destination URL : ");
        if (scanf("%29s", d) != 1) continue;

        for (int i = 0; i < SIZE; i++) {
            if (strcmp(d, host[i].url) == 0) {
                dest = host[i];
                f2 = 1;
                break;
            }
        }
        if (f2 == 0) {
            printf("\nDestination URL Not Found! Please Enter a Valid Destination URL.\n");
        }
    } while (f2 == 0);

    printf("\nSOURCE DETAILS\nURL : %s\nIP : %s\nMAC : %s\n", src.url, src.ip, src.mac);
    printf("\nDESTINATION DETAILS\nURL : %s\nIP : %s\nMAC : %s\n", dest.url, dest.ip, dest.mac);
}

void saveFile() {
    FILE *fp = fopen("message.txt", "w");
    if (fp == NULL) {
        printf("\nFile Cannot Be Created\n");
        return;
    }
    fprintf(fp, "SOURCE URL : %s\nDESTINATION URL : %s\n\n", src.url, dest.url);
    fprintf(fp, "SOURCE IP : %s\nDESTINATION IP : %s\n\n", src.ip, dest.ip);
    fprintf(fp, "SOURCE MAC : %s\nDESTINATION MAC : %s\n\n", src.mac, dest.mac);
    fprintf(fp, "ORIGINAL MESSAGE\n%s\n", msg);
    fprintf(fp, "\nSTUFFED MESSAGE\n%s\n", out);
    fclose(fp);
    printf("\nMessage Stored Successfully in message.txt\n");
}


