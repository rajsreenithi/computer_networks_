#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SIZE 100

// Create client socket
void createSocket(int *clientSocket) {
    *clientSocket = socket(AF_INET, SOCK_STREAM, 0);

    if (*clientSocket < 0) {
        perror("Socket creation failed");
        exit(1);
    }
}

// Connect to server
void connectToServer(int clientSocket, char *ip, int port) {
    struct sockaddr_in serverAddress;
    memset(&serverAddress, 0, sizeof(serverAddress));
    serverAddress.sin_family = AF_INET;
    serverAddress.sin_port = htons(port);

    if (inet_pton(AF_INET, ip, &serverAddress.sin_addr) <= 0) {
        perror("Invalid IP address");
        exit(1);
    }

    if (connect(clientSocket, (struct sockaddr *)&serverAddress, sizeof(serverAddress)) < 0) {
        perror("Connection failed");
        exit(1);
    }

    printf("Connected to server\n");
}

// Send message to server
void sendMessage(int clientSocket, char *message) {
    send(clientSocket, message, strlen(message) + 1, 0);
}

// Receive message from server
int receiveMessage(int clientSocket, char *message) {
    int bytes;
    memset(message, 0, SIZE);
    bytes = recv(clientSocket, message, SIZE, 0);
    return bytes;
}

// Chat with server
void chatWithServer(int clientSocket) {
    char message[SIZE];

    while (1) {
        printf("Client: ");

        fgets(message, SIZE, stdin);
        message[strcspn(message, "\n")] = '\0';

        sendMessage(clientSocket, message);

        if (strcmp(message, "exit") == 0) {
            break;
        }

        if (receiveMessage(clientSocket, message) <= 0) {
            break;
        }

        printf("Server: %s\n", message);

        if (strcmp(message, "exit") == 0) {
            break;
        }
    }
}

// Run client
void runClient(char *ip, int port) {
    int clientSocket;

    createSocket(&clientSocket);
    connectToServer(clientSocket, ip, port);
    chatWithServer(clientSocket);
    close(clientSocket);
}

int main(int argc, char *argv[]) {
    if (argc != 3) {
        printf("Usage: %s <server_ip> <port>\n", argv[0]);
        return 1;
    }

    runClient(argv[1], atoi(argv[2]));
    return 0;
}
