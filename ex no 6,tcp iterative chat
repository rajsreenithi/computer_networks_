#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define SIZE 100

// Create server socket
void createServer(int *serverSocket) {
    *serverSocket = socket(AF_INET, SOCK_STREAM, 0);

    if (*serverSocket < 0) {
        perror("Socket creation failed");
        exit(1);
    }

    printf("Server socket created\n");
}

// Bind server socket with port
void bindServer(int serverSocket, int port) {
    struct sockaddr_in serverAddress;
    memset(&serverAddress, 0, sizeof(serverAddress));
    serverAddress.sin_family = AF_INET;
    serverAddress.sin_addr.s_addr = INADDR_ANY;
    serverAddress.sin_port = htons(port);

    if (bind(serverSocket, (struct sockaddr *)&serverAddress, sizeof(serverAddress)) < 0) {
        perror("Bind failed");
        exit(1);
    }

    printf("Server bind successful\n");
}

// Listen for client
void listenForClient(int serverSocket) {
    if (listen(serverSocket, 5) < 0) {
        perror("Listen failed");
        exit(1);
    }

    printf("Server waiting for client...\n");
}

// Accept client connection
int acceptClient(int serverSocket, struct sockaddr_in *clientAddress, socklen_t *clientLength) {
    int clientSocket;
    clientSocket = accept(serverSocket, (struct sockaddr *)clientAddress, clientLength);

    if (clientSocket < 0) {
        perror("Accept failed");
        return -1;
    }

    printf("Client connected\n");
    return clientSocket;
}

// Receive message from client
int receiveMessage(int clientSocket, char *message) {
    int bytes;
    memset(message, 0, SIZE);
    bytes = recv(clientSocket, message, SIZE, 0);
    return bytes;
}

// Send message to client
void sendMessage(int clientSocket, char *message) {
    send(clientSocket, message, strlen(message) + 1, 0);
}

// Chat with client
void chatWithClient(int clientSocket) {
    char message[SIZE];

    while (1) {
        if (receiveMessage(clientSocket, message) <= 0) {
            break;
        }

        if (strcmp(message, "exit") == 0) {
            printf("Client ended the chat\n");
            break;
        }

        printf("Client: %s\n", message);
        printf("Server: ");

        fgets(message, SIZE, stdin);
        message[strcspn(message, "\n")] = '\0';

        sendMessage(clientSocket, message);

        if (strcmp(message, "exit") == 0) {
            break;
        }
    }
}

// Close client socket
void closeClient(int clientSocket) {
    close(clientSocket);
    printf("Client disconnected\n");
}

// Run iterative server
void runServer(int port) {
    int serverSocket;
    int clientSocket;

    struct sockaddr_in clientAddress;
    socklen_t clientLength;

    clientLength = sizeof(clientAddress);

    createServer(&serverSocket);
    bindServer(serverSocket, port);
    listenForClient(serverSocket);

    while (1) {
        clientSocket = acceptClient(serverSocket, &clientAddress, &clientLength);

        if (clientSocket < 0) {
            continue;
        }

        chatWithClient(clientSocket);
        closeClient(clientSocket);

        printf("Waiting for next client...\n");
    }

    close(serverSocket);
}

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    runServer(atoi(argv[1]));
    return 0;
}
